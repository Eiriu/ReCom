; Engine configuration file.
; Open this folder in Godot 4 (standard edition) to work on the game.

config_version=5

[application]

config/name="Annexation"
config/description="Alien-invasion strategy game: Long War 1 seen from the invader's side. Working title."
run/main_scene="res://ui/battle_screen.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="gl_compatibility"
